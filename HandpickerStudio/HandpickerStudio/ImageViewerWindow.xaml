<Window x:Class="HandpickerStudio.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandpickerStudio"
        Style="{StaticResource StudioWindowStyle}" Width="960" Height="690" MinWidth="380" MinHeight="260" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" PreviewKeyDown="NavigateWithKey" PreviewMouseWheel="NavigateWithWheel" Closing="ConfirmClose"
        FocusManager.FocusedElement="{Binding ElementName=Preview}">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PreviousButton" Content="前へ" Click="Previous" Margin="3,0" />
                <Button x:Name="NextButton" Content="次へ" Click="Next" Margin="3,0" />
                <Button Content="閉じる" IsCancel="True" Margin="3,0" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                <TextBlock x:Name="ImageName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ImagePath" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ElementName=Preview, Path=ToolTip}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" />
        <Border x:Name="ImageViewport" Background="#182032" CornerRadius="5" Padding="6"
                MouseLeftButtonDown="ToggleExpandedView" ContextMenuOpening="PrepareMenu">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem x:Name="ViewerRecycle" Header="ごみ箱へ移動" InputGestureText="Delete" Click="RecycleCurrent" />
                    <MenuItem x:Name="ViewerThumbnail" Header="代表サムネイルに設定" Click="SetCurrentThumbnail" />
                </ContextMenu>
            </Border.ContextMenu>
            <local:ImagePreview x:Name="Preview" DecodeLimit="3200" Stretch="Uniform" Focusable="True" />
        </Border>
    </DockPanel>
</Window>
