<Window x:Class="HandpickerStudio.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandpickerStudio"
        Width="960" Height="690" MinWidth="380" MinHeight="260" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" PreviewKeyDown="NavigateWithKey">
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="PreviousButton" Content="前へ" Click="Previous" Margin="3,0" />
                <Button x:Name="NextButton" Content="次へ" Click="Next" Margin="3,0" />
                <Button Content="閉じる" IsCancel="True" Margin="3,0" />
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,9,0">
                <TextBlock x:Name="ImageName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ImagePath" Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ElementName=Preview, Path=ToolTip}" TextWrapping="Wrap" Foreground="#9D2E19" />
        <Border Background="#182032" CornerRadius="5" Padding="6">
            <local:ImagePreview x:Name="Preview" DecodeLimit="3200" Stretch="Uniform" />
        </Border>
    </DockPanel>
</Window>
