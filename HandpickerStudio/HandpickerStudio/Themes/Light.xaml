<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CanvasBrush" Color="#F2F5FA" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#CFD9E7" />
    <SolidColorBrush x:Key="TextBrush" Color="#182840" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4C617D" />
    <SolidColorBrush x:Key="WarningBrush" Color="#864900" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#9D2E19" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#1767BE" />
    <SolidColorBrush x:Key="SelectionFillBrush" Color="#E2EFFF" />
</ResourceDictionary>
