<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="CanvasBrush" Color="#1A202B" />
    <SolidColorBrush x:Key="PanelBrush" Color="#232B39" />
    <SolidColorBrush x:Key="BorderBrush" Color="#435166" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECF2FC" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B7C7DC" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFD092" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFB4A0" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#91BFFF" />
    <SolidColorBrush x:Key="SelectionFillBrush" Color="#303F57" />
</ResourceDictionary>
