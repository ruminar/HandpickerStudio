<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>0.1.0</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon Condition="Exists('Assets/HandpickerStudio.ico')">Assets/HandpickerStudio.ico</ApplicationIcon>
    <DefaultItemExcludesInProjectFolder>$(DefaultItemExcludesInProjectFolder);bin/**;obj/**</DefaultItemExcludesInProjectFolder>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <ProjectReference Include="../HandpickerStudio.Update/HandpickerStudio.Update.csproj" />
    <EmbeddedResource Include="$(UpdateProfileFile)" LogicalName="HandpickerStudio.UpdateProfile.json" Condition="'$(UpdateProfileFile)' != ''" />
  </ItemGroup>

</Project>
