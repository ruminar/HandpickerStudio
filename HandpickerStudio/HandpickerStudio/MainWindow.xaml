<Window x:Class="HandpickerStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HandpickerStudio"
        Style="{StaticResource StudioWindowStyle}" Title="HandpickerStudio" Width="1130" Height="760" MinWidth="790" MinHeight="510"
        SourceInitialized="RestorePlacement" Loaded="OnLoaded" StateChanged="RememberWindowState" Closing="OnClosing" Closed="OnClosed">
    <Window.Resources>
        <DataTemplate x:Key="ImageListTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="2,4,2,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource CanvasBrush}" CornerRadius="4" Height="94">
                        <local:ImagePreview FilePath="{Binding FullPath}" DecodeLimit="{x:Static local:PreviewCache.ListDecodeLimit}" Stretch="Uniform"
                                            Cache="{Binding DataContext.GalleryCache, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,47,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding FullPath}" ToolTip="{Binding FullPath}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Problem}" ToolTip="{Binding Problem}" Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="ImageTileTemplate">
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="5" Margin="2">
                <Border.ToolTip>
                    <ToolTip>
                        <StackPanel>
                            <TextBlock Text="{Binding FullPath}" />
                            <TextBlock Text="{Binding Problem}" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Background="{DynamicResource CanvasBrush}" CornerRadius="3">
                        <local:ImagePreview FilePath="{Binding FullPath}" DecodeLimit="{x:Static local:PreviewCache.TileDecodeLimit}" Stretch="Uniform"
                                            Cache="{Binding DataContext.GalleryCache, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="2,4,2,0">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="SimpleImageTileTemplate">
            <Border Background="{DynamicResource CanvasBrush}" CornerRadius="3" Margin="2">
                <local:ImagePreview FilePath="{Binding FullPath}" DecodeLimit="{x:Static local:PreviewCache.TileDecodeLimit}" Stretch="Uniform"
                                    Cache="{Binding DataContext.GalleryCache, RelativeSource={RelativeSource AncestorType=Window}}" />
            </Border>
        </DataTemplate>
        <ItemsPanelTemplate x:Key="ImageTilePanel">
            <local:VirtualizingTilePanel TileSize="{Binding TileSize}" ClipToBounds="True" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="SimpleImageTilePanel">
            <local:VirtualizingTilePanel TileSize="{Binding TileSize}" ImageOnly="True" ClipToBounds="True" />
        </ItemsPanelTemplate>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="18,14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="HandpickerStudio" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="登録" Click="AddProject" IsEnabled="{Binding CanSave}" Margin="0,0,6,0" />
                    <Button Content="設定" Click="EditProject" IsEnabled="{Binding CanEditProject}" Margin="0,0,6,0" />
                    <Button Content="登録解除" Click="RemoveProject" IsEnabled="{Binding CanEditProject}" Margin="0,0,6,0" />
                    <Button Content="更新" Click="Reload" Margin="0,0,6,0" />
                    <Button x:Name="AppUpdateButton" Content="アプリの更新を確認" Click="CheckForAppUpdate" Margin="0,0,6,0" />
                    <Button Content="表示設定" Click="EditAppearance" IsEnabled="{Binding CanSave}" />
                </StackPanel>
                <ComboBox x:Name="ProjectPicker" ItemsSource="{Binding Projects}" DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedProject, Mode=TwoWay}" AutomationProperties.Name="プロジェクト"
                          Margin="22,0,14,0" MinWidth="115" Padding="7,4" VerticalContentAlignment="Center" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="18,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                <Button DockPanel.Dock="Left" Content="確認事項" Click="ShowWarnings" Margin="0,0,8,0"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BooleanVisibility}}" />
                <Button DockPanel.Dock="Left" Content="名前の重複" Click="ShowCollisions" Foreground="{DynamicResource WarningBrush}"
                        Visibility="{Binding HasCollisions, Converter={StaticResource BooleanVisibility}}" />
                <TextBlock />
            </DockPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="212" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="*" MinWidth="330" />
            </Grid.ColumnDefinitions>

            <TabControl BorderBrush="{DynamicResource BorderBrush}" Background="{DynamicResource PanelBrush}">
                <TabItem Header="Checkpoint">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Bottom" Content="{Binding UnresolvedLabel}" Click="ShowUnresolved"
                                HorizontalContentAlignment="Left" Margin="0,8,0,0" />
                        <StackPanel x:Name="CheckpointPanes" Background="{DynamicResource PanelBrush}" ClipToBounds="True"
                                    SizeChanged="CheckpointPanesSizeChanged"
                                    AllowDrop="True" PreviewMouseLeftButtonDown="BeginCheckpointDrag" PreviewMouseMove="TrackCheckpointDrag"
                                    PreviewMouseLeftButtonUp="FinishCheckpointClick" MouseLeave="CancelCheckpointPress"
                                    DragOver="CheckpointDragOver" DragLeave="CheckpointDragLeave" Drop="DropCheckpoint"
                                    PreviewMouseRightButtonDown="CheckpointMenuTarget" ContextMenuOpening="PrepareCheckpointMenu">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="RatingMenu" Header="評価を変更" />
                                    <MenuItem x:Name="ArchiveMenu" Header="アーカイブ化" Click="ArchiveSelectedCheckpoints" />
                                    <MenuItem x:Name="RestoreArchiveMenu" Header="アーカイブ化解除" Click="RestoreSelectedCheckpoints" />
                                    <MenuItem x:Name="DisposeMenu" Header="Checkpointを廃棄…" Click="DisposeCheckpoint" />
                                    <MenuItem Header="廃棄後処理を再開" Click="ResumeDisposal" />
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                        </StackPanel>
                    </DockPanel>
                </TabItem>
                <TabItem Header="参照ルート">
                    <DockPanel Margin="8">
                        <Button DockPanel.Dock="Bottom" Content="参照ルートを編集" Click="EditRoots"
                                IsEnabled="{Binding CanEditProject}" Margin="0,8,0,0" />
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding Roots}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="9" Margin="0,0,2,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Root.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,6" />
                                                <TextBlock Text="Output" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Root.OutputPath}" TextWrapping="Wrap" Margin="0,0,0,5" />
                                                <TextBlock Text="Archive" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Root.ArchivePath}" TextWrapping="Wrap" />
                                                <Button Content="{Binding Action}" Click="ToggleRoot" Tag="{Binding Root}" Margin="0,8,0,0"
                                                        IsEnabled="{Binding DataContext.CanSave, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        HorizontalAlignment="Left" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="1" Width="7" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="14">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Button DockPanel.Dock="Right" Content="開く" Click="OpenSelectedImage" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedItem, ElementName=Gallery}" Value="{x:Null}">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ComboBox x:Name="GalleryViewPicker" DockPanel.Dock="Right" VerticalAlignment="Center" MinWidth="106"
                                  AutomationProperties.Name="画像の表示形式" ToolTip="タイルでは Ctrl＋ホイールでサイズを変更"
                                  SelectedIndex="{Binding GalleryViewIndex, Mode=OneWay}" SelectionChanged="ChangeGalleryView">
                            <ComboBoxItem Content="一覧" />
                            <ComboBoxItem Content="タイル" />
                            <ComboBoxItem Content="タイル(簡易)" />
                        </ComboBox>
                        <StackPanel>
                            <TextBlock Text="{Binding GalleryTitle}" FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding GalleryContext}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Grid>
                        <ListBox x:Name="Gallery" ItemsSource="{Binding Images}" BorderThickness="0" SelectionMode="Extended"
                                 Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}"
                                 PreviewMouseDoubleClick="OpenImage" PreviewMouseWheel="ResizeTilesWithWheel" KeyDown="OpenImageWithKey"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 PreviewMouseRightButtonDown="ImageMenuTarget" ContextMenuOpening="PrepareImageMenu"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem x:Name="RecycleImagesMenu" Header="ごみ箱へ移動" InputGestureText="Delete" Click="RecycleSelectedImages" />
                                    <MenuItem x:Name="MoveImagesMenu" Header="プロジェクトへ移動…" Click="MoveSelectedImages" />
                                    <MenuItem x:Name="ThumbnailMenu" Header="代表サムネイルに設定" Click="SetSelectedThumbnail" />
                                    <MenuItem x:Name="ReleaseLegacyHoldsMenu" Header="旧版の保留を解除…" Click="ReleaseLegacyHolds" Visibility="Collapsed" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.Style>
                                <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                    <Setter Property="ItemTemplate" Value="{StaticResource ImageListTemplate}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding GalleryView}" Value="{x:Static local:GalleryLayout.Tiles}">
                                            <Setter Property="ItemTemplate" Value="{StaticResource ImageTileTemplate}" />
                                            <Setter Property="ItemsPanel" Value="{StaticResource ImageTilePanel}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding GalleryView}" Value="{x:Static local:GalleryLayout.SimpleTiles}">
                                            <Setter Property="ItemTemplate" Value="{StaticResource SimpleImageTileTemplate}" />
                                            <Setter Property="ItemsPanel" Value="{StaticResource SimpleImageTilePanel}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="1" />
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="SelectionFrame" Background="Transparent" BorderBrush="Transparent"
                                                        BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <Grid>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                        <Grid x:Name="SelectionMark" Width="44" Height="44"
                                                              HorizontalAlignment="Right" VerticalAlignment="Top"
                                                              Visibility="Collapsed" IsHitTestVisible="False">
                                                            <Path Data="M 1,1 L 26,1 43,18 43,43 Z"
                                                                  Fill="#AD5723" Stroke="White" StrokeThickness="1.25" StrokeLineJoin="Round" />
                                                            <Path Data="M 27,7.5 L 28.8,11.7 33.3,12.1 29.9,15 30.9,19.5 27,17.2 23.1,19.5 24.1,15 20.7,12.1 25.2,11.7 Z"
                                                                  Stroke="White" StrokeThickness="1.7" StrokeLineJoin="Round" />
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="SelectionFrame" Property="BorderBrush"
                                                                Value="{DynamicResource SelectionBrush}" />
                                                        <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <TextBlock Text="{Binding EmptyGalleryMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" IsHitTestVisible="False"
                                   Visibility="{Binding IsGalleryEmpty, Converter={StaticResource BooleanVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
