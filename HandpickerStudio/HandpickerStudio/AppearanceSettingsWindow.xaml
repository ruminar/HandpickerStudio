<Window x:Class="HandpickerStudio.AppearanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource StudioWindowStyle}" Title="表示設定"
        Width="330" SizeToContent="Height" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16">
        <Label Content="_配色" Target="{Binding ElementName=AppearancePicker}" Padding="0,0,0,6" />
        <ComboBox x:Name="AppearancePicker" AutomationProperties.Name="配色">
            <ComboBoxItem Content="ライト" />
            <ComboBoxItem Content="ダーク" />
        </ComboBox>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="適用" IsDefault="True" Click="Apply" MinWidth="76" Margin="0,0,8,0" />
            <Button Content="キャンセル" IsCancel="True" MinWidth="76" />
        </StackPanel>
    </StackPanel>
</Window>
