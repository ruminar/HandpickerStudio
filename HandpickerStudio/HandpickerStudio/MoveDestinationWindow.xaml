<Window x:Class="HandpickerStudio.MoveDestinationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="画像の移動先" Width="540" Height="335" MinWidth="430" MinHeight="290"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closed="CancelLoad">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom">
            <TextBlock x:Name="DestinationPath" TextWrapping="Wrap" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="キャンセル" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="MoveButton" Content="移動" Click="Confirm" IsDefault="True" IsEnabled="False" />
            </StackPanel>
        </StackPanel>
        <StackPanel>
            <Label Content="移動先プロジェクト" Target="{Binding ElementName=ProjectsBox}" />
            <ComboBox x:Name="ProjectsBox" DisplayMemberPath="Name" SelectionChanged="ProjectChanged" />
            <Label Content="参照ルート" Target="{Binding ElementName=RootsBox}" />
            <ComboBox x:Name="RootsBox" DisplayMemberPath="Name" SelectionChanged="DestinationChanged" />
            <Label Content="Checkpoint" Target="{Binding ElementName=CheckpointsBox}" />
            <ComboBox x:Name="CheckpointsBox" DisplayMemberPath="RelativePath" SelectionChanged="DestinationChanged" />
        </StackPanel>
    </DockPanel>
</Window>
