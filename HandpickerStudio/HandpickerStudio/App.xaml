<Application x:Class="HandpickerStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml" ThemeMode="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HandpickerStudio;component/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
            <Style x:Key="StudioWindowStyle" TargetType="Window">
                <Setter Property="FontFamily" Value="Yu Gothic UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                <Setter Property="Background" Value="{DynamicResource CanvasBrush}" />
            </Style>
            <Style TargetType="Window" BasedOn="{StaticResource StudioWindowStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
