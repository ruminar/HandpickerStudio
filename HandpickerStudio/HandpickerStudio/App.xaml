<Application x:Class="HandpickerStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanVisibility" />
        <SolidColorBrush x:Key="CanvasBrush" Color="#F2F5FA" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9E2EF" />
        <SolidColorBrush x:Key="TextBrush" Color="#182840" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#4C617D" />
        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="30" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Application.Resources>
</Application>
